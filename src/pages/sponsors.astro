---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';

const sponsors = [
  { name: 'MCTekK', href: 'https://mctekk.com' },
  { name: 'Cloudflare', href: 'https://www.cloudflare.com/' },
  { name: 'Abits', href: 'https://abits.com' },
  { name: 'Crowdin', href: 'https://crowdin.com/' },
  { name: 'Algolia', href: 'https://algolia.com' },
  { name: 'O2', href: 'https://odva.pro/' },
  { name: 'DigitalOcean', href: 'https://www.digitalocean.com/' },
  { name: 'Postype', href: 'https://www.postype.com/' },
  { name: 'JetBrains Qodana', href: 'https://www.jetbrains.com/qodana/' },
];
---

<BaseLayout title="Sponsors" description="Sponsors and supporters funding the development of the Phalcon framework.">
  <PageHero kicker="Non-profit · sponsor-funded" title="Sponsors.">
    <p>
      For those that wish to sponsor our work and further the development of Phalcon, we offer various sponsorship
      options that will fit any budget. Sponsoring our work allows us to devote more time to the project, offer faster
      responses to bugs and features and ensure the projects's stability.
    </p>
  </PageHero>

  <Section tone="light">
    <p class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-(--tone-muted)">Sponsors and supporters</p>
    <div class="mt-5 flex flex-wrap gap-3">
      {
        sponsors.map((sponsor) => (
          <a
            href={sponsor.href}
            target="_blank"
            class="rounded-sm border border-lightline-300 bg-white px-[18px] py-[11px] font-display text-sm font-semibold text-ink-900 hover:border-teal-600"
          >
            {sponsor.name}
          </a>
        ))
      }
    </div>

    <div class="mt-12 grid grid-cols-1 gap-4 md:grid-cols-2">
      <div class="rounded-md border border-(--tone-border-strong) bg-(--tone-surface) px-[22px] py-5">
        <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.14em] text-teal-600">GitHub Sponsors</p>
        <p class="mt-[10px] text-[15px] leading-[1.65] text-(--tone-text)">
          Sponsor the core team directly through GitHub Sponsors.
        </p>
        <a
          href="https://phalcon.io/fund"
          class="mt-4 inline-block rounded-sm bg-ink-900 px-5 py-[11px] text-sm font-semibold text-paper-100 hover:opacity-90"
          >Fund the project →</a
        >
      </div>
      <div class="rounded-md border border-(--tone-border-strong) bg-(--tone-surface) px-[22px] py-5">
        <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.14em] text-teal-600">OpenCollective</p>
        <p class="mt-[10px] text-[15px] leading-[1.65] text-(--tone-text)">
          Become a backer or sponsor on our OpenCollective page and appear among our public supporters.
        </p>
        <a
          href="https://opencollective.com/phalcon/#contributors"
          class="mt-4 inline-block rounded-sm border border-lightline-300 px-5 py-[11px] text-sm font-semibold text-ink-900 hover:border-teal-600"
          >Become a Patron →</a
        >
      </div>
    </div>
  </Section>
</BaseLayout>
