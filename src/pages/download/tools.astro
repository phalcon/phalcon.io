---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import SubNav from '../../components/SubNav.astro';
import CodeBlock from '../../components/CodeBlock.astro';

const DOWNLOAD_NAV = [
  { label: 'Linux/Unix/Mac', href: '/download/linux' },
  { label: 'Windows DLLs', href: '/download/windows' },
  { label: 'Developer Tools', href: '/download/tools' },
  { label: 'IDE Stubs', href: '/download/stubs' },
];
---

<BaseLayout title="Developer Tools" description="Phalcon Developer Tools: scaffolding scripts that generate skeleton code for controllers, models and full applications.">
  <PageHero kicker="Get Phalcon" title="Developer Tools.">
    <p>
      These tools are a collection of useful scripts to generate skeleton code. Core components of your application can
      be generated with a simple command, allowing you to easily develop applications using Phalcon.
    </p>
  </PageHero>

  <Section tone="light">
    <SubNav items={DOWNLOAD_NAV} current="/download/tools" />

    <div class="content-links max-w-[820px]">
      <p class="text-[15px] leading-[1.7] text-(--tone-muted)">
        Documentation: <a href="https://docs.phalcon.io/latest/devtools/">Phalcon Developer Tools</a>
      </p>

      <h2 class="mt-8 font-display text-2xl font-semibold tracking-[-0.01em] text-(--tone-text)">Installing via Composer</h2>

      <p class="mt-4 text-[15px] leading-[1.7] text-(--tone-muted)">Install composer in a common location or in your project:</p>
      <div class="mt-3">
        <CodeBlock lang="bash" filename="shell" code={`curl -s https://getcomposer.org/installer | php`} />
      </div>

      <p class="mt-5 text-[15px] leading-[1.7] text-(--tone-muted)">Create the composer.json file as follows:</p>
      <div class="mt-3">
        <CodeBlock
          lang="json"
          filename="composer.json"
          code={`{\n    "require": {\n        "phalcon/devtools": "dev-master"\n    }\n}`}
        />
      </div>

      <p class="mt-5 text-[15px] leading-[1.7] text-(--tone-muted)">Run the composer installer:</p>
      <div class="mt-3">
        <CodeBlock lang="bash" filename="shell" code={`php composer.phar install`} />
      </div>

      <p class="mt-5 text-[15px] leading-[1.7] text-(--tone-muted)">Create a symbolic link to the phalcon.php script:</p>
      <div class="mt-3">
        <CodeBlock
          lang="bash"
          filename="shell"
          code={`ln -s ~/phalcon-devtools/phalcon /usr/bin/phalcon\nchmod ugo+x /usr/bin/phalcon`}
        />
      </div>

      <h2 class="mt-10 font-display text-2xl font-semibold tracking-[-0.01em] text-(--tone-text)">Download</h2>
      <p class="mt-3 text-[15px] leading-[1.7] text-(--tone-muted)">
        You can download or clone a cross platform package containing the developer tools from
        <a href="https://github.com/phalcon/phalcon-devtools">Github</a>.
      </p>
    </div>
  </Section>
</BaseLayout>
