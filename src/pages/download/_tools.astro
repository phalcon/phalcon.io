---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import SubNav from '../../components/SubNav.astro';
import V6Callout from '../../components/V6Callout.astro';
import { docs, DOWNLOAD_NAV } from '../../data/site.mjs';

const h2 = 'mt-12 font-display text-2xl font-semibold tracking-[-0.01em] text-(--tone-text)';
const p = 'mt-3 text-[15px] leading-[1.7] text-(--tone-muted)';
---

<BaseLayout
  title="Developer Tools"
  description="Phalcon Developer Tools: scripts that generate skeleton code for controllers, models and full applications."
>
  <PageHero kicker="Get Phalcon · v5" title="Developer Tools.">
    <p>
      These tools are a collection of useful scripts to generate skeleton code. Core components of your application can
      be generated with a simple command, allowing you to easily develop applications using Phalcon.
    </p>
  </PageHero>

  <Section tone="light">
    <SubNav items={DOWNLOAD_NAV} current="/download/tools" />
    <V6Callout />

    <div class="content-links max-w-[820px]">
      <Card variant="accent" label="Pre-release for v5" labelColor="var(--ph-warntext-700)" barColor="var(--ph-warn-300)">
        The Developer Tools have no release for v5 yet. v5 support is on the
        <a href="https://github.com/phalcon/phalcon-devtools/tree/5.0.x">5.0.x branch</a>. Composer installs it with the
        <code>@dev</code> flag.
      </Card>

      <h2 class={h2}>Install with Composer</h2>
      <p class={p}>In your project:</p>
      <div class="mt-3">
        <CodeBlock lang="bash" filename="shell" code={`composer require phalcon/devtools:"^5.0@dev" --dev`} />
      </div>
      <p class={p}>Or for all projects on your machine:</p>
      <div class="mt-3">
        <CodeBlock lang="bash" filename="shell" code={`composer global require phalcon/devtools:"^5.0@dev" --dev`} />
      </div>
      <p class={p}>The <a href={docs('devtools')}>Developer Tools documentation</a> lists the commands.</p>

      <h2 class={h2}>Source</h2>
      <p class={p}>
        The source is on <a href="https://github.com/phalcon/phalcon-devtools">GitHub</a>.
      </p>
    </div>
  </Section>
</BaseLayout>
