---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CopyCommand from '../../components/CopyCommand.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import SubNav from '../../components/SubNav.astro';
import { docs, DOWNLOAD_NAV, FLAVORS } from '../../data/site.mjs';

const v6 = FLAVORS.v6;
const h2 = 'mt-10 font-display text-2xl font-semibold tracking-[-0.01em] text-(--tone-text)';
const p = 'mt-3 text-[15px] leading-[1.7] text-(--tone-muted)';
---

<BaseLayout title="Install v6 with Composer" description="Install Phalcon v6, the pure PHP edition of the framework, with Composer.">
  <PageHero kicker="Get Phalcon · v6" title="Composer.">
    <p>{v6.title} is pure PHP. Composer installs it like any other package. There is no extension to compile or enable.</p>
  </PageHero>

  <Section tone="light">
    <SubNav items={DOWNLOAD_NAV} current="/download/composer" />

    <div class="content-links max-w-[820px]">
      <CopyCommand command={v6.install} />
      <p class="mt-3 text-[13px] leading-[1.6] text-(--tone-faint)">Status: {v6.status.toLowerCase()}, {v6.version}.</p>

      <h2 class={h2}>Requirements</h2>
      <p class={p}>PHP {v6.php} and these extensions: {v6.extensions.join(', ')}.</p>
      <p class={p}>
        Some components need more extensions, for example the PDO driver of your database, or gd or imagick for images.
      </p>

      <h2 class={h2}>Next steps</h2>
      <p class={p}>
        Read the <a href={docs('installation', '6.0')}>v6 installation guide</a> and the
        <a href={v6.docs}>v6 documentation</a>.
      </p>
      <p class={p}>You do not need IDE stubs for v6. The framework source is PHP, so your IDE reads it directly.</p>

      <h2 class={h2}>Prefer the C extension?</h2>
      <p class={p}>
        {FLAVORS.v5.title} has the same API and the best speed. See <a href="/download/linux">Linux, macOS & BSD</a> or
        <a href="/download/windows">Windows</a>.
      </p>
    </div>
  </Section>
</BaseLayout>
