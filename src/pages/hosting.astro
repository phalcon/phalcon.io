    name: 'Mediasecure',
    href: 'https://www.mediasecure.org/',
    logo: '/images/hosting/mediasecure-gray.png',
    paragraphs: [
      'High performance Dedicated Servers with protection against threats including Distributed Denial of Service (DDoS) attacks. Our high-capacity DDoS-Protected network can automatically protect your dedicated server from DDoS attacks up to 4.2 Tbps. <a href="https://www.mediasecure.org/">See more</a>',
    ],
  },
  {
    name: 'Rackspace',
    href: 'https://www.rackspace.com/cloud/servers/',
