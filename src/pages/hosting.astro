---

<BaseLayout title="Hosting" description="Hosting providers where the Phalcon framework can be installed or comes pre-installed.">
  <PageHero kicker="Deploy" title="Hosting.">
    <p>
      Phalcon can be installed on any machine on which the hosting provider offers SSH root access (or sudo). Below is a
      list of reputable companies that offer such services:
    </p>
  </PageHero>

  <Section tone="light">
    <div class="flex flex-col gap-4">
      {
        providers.map((provider) => (
          <div class="grid grid-cols-1 items-start gap-6 rounded-md border border-(--tone-border-strong) bg-(--tone-surface) p-6 sm:grid-cols-[180px_1fr]">
            <img src={provider.logo} alt={provider.name} class="max-h-[64px] w-auto max-w-[160px] object-contain" />
            <div>
              <h2 class="font-display text-lg font-bold text-(--tone-text)">
                <a href={provider.href} target="_blank" class="hover:text-(--tone-accent)">
                  {provider.name} ↗
                </a>
              </h2>
              {provider.paragraphs.map((p) => (
                <p class="content-links mt-3 max-w-[760px] text-[15px] leading-[1.65] text-(--tone-muted)" set:html={p} />
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </Section>
</BaseLayout>
