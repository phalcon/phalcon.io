---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import SubNav from '../components/SubNav.astro';
import { BUILT_WITH, orderTags } from '../data/built-with.mjs';
import { CONTACT_EMAIL, PROJECT_NAV } from '../data/site.mjs';
---

<BaseLayout title="Built with Phalcon" description="Websites and applications that run on the Phalcon PHP framework.">
  <PageHero kicker="Showcase" title="Built with Phalcon.">
    <p>
      The projects on this page run on Phalcon. If you have built a project with Phalcon and want it on this page, send
      us an email at <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> with its name, its link and a short
      description, or <a href="https://github.com/phalcon/phalcon.io#built-with-phalcon-add-your-project">open a pull request</a>.
    </p>
  </PageHero>

  <Section tone="light">
    <SubNav items={PROJECT_NAV} current="/built-with" />
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        BUILT_WITH.map((entry) => (
          <article class="overflow-hidden rounded-md border border-(--tone-border-strong) bg-(--tone-surface)">
            <img
              src={`/images/built-with/${entry.slug}.webp`}
              width="1280"
              height="800"
              loading="lazy"
              decoding="async"
              alt={entry.alt}
              class="aspect-[16/10] w-full border-b border-(--tone-border-strong) object-cover object-top"
            />
            <div class="p-5">
              <h2 class="font-display text-xl font-bold text-(--tone-text)">
                <a href={entry.href} class="text-(--tone-accent) hover:text-(--tone-accent-hover) hover:underline">
                  {entry.name} ↗
                </a>
              </h2>
              <p class="mt-2 text-[15px] leading-[1.65] text-(--tone-muted)">{entry.description}</p>
              <ul aria-label="Tags" class="mt-3 flex flex-wrap gap-1.5">
                {orderTags(entry.tags).map((tag) => (
                  <li class="rounded-xs border border-(--tone-border-strong) px-2 py-0.5 font-mono text-[11px] font-semibold tracking-[0.04em] text-(--tone-muted)">
                    {tag}
                  </li>
                ))}
              </ul>
              {(entry.source || entry.author) && (
                <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs font-semibold text-(--tone-muted)">
                  {entry.source && (
                    <a href={entry.source} class="text-(--tone-accent) hover:underline">
                      Source ↗
                    </a>
                  )}
                  {entry.author && (
                    <span>
                      By{' '}
                      {entry.authorHref ? (
                        <a href={entry.authorHref} class="text-(--tone-accent) hover:underline">
                          {entry.author}
                        </a>
                      ) : (
                        entry.author
                      )}
                    </span>
                  )}
                </p>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </Section>
</BaseLayout>
