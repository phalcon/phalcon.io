---
import { Code } from 'astro:components';
import type { BundledLanguage, ShikiTransformer } from 'shiki';
import { CODE_THEME } from '../lib/code-theme.mjs';

interface Props {
  code: string;
  lang?: BundledLanguage;
  filename?: string;
  copyable?: boolean;
  class?: string;
}

const { code, lang = 'php', filename, copyable = true, class: className = '' } = Astro.props;

/*
 * Shiki writes the colors and the font styles of the code as style
 * attributes. The CSP in public/_headers blocks style attributes, so each
 * style becomes a class of src/styles/global.css. An unknown style stops
 * the build.
 */
const FONT_CLASSES: Record<string, string> = {
  'font-style:italic': 'code-italic',
  'font-weight:bold': 'code-bold',
  'text-decoration:line-through': 'code-strikethrough',
  'text-decoration:underline': 'code-underline',
};

const styleToClass: ShikiTransformer = {
  name: 'phalcon:style-to-class',
  pre(node) {
    // .astro-code in global.css sets the background, the color and the overflow.
    delete node.properties.style;
  },
  span(node) {
    const style = node.properties.style;

    if (typeof style !== 'string') {
      return;
    }

    for (const declaration of style.split(';')) {
      const role = /^color:var\(--code-([a-z0-9-]+)\)$/.exec(declaration)?.[1];
      const name = role ? `code-${role}` : FONT_CLASSES[declaration];

      if (!name) {
        throw new Error(`CodeBlock: no class for the code style "${declaration}"`);
      }

      this.addClassToHast(node, name);
    }

    delete node.properties.style;
  },
};
---

<div class:list={['overflow-hidden rounded-lg border border-line-900 bg-surface-900', className]}>
  {
    (filename || copyable) && (
      <div class="flex items-center justify-between border-b border-line-900 px-[15px] py-[10px]">
        <span class="font-mono text-xs font-medium text-faint-500">{filename ?? lang}</span>
        {copyable && (
          <button
            type="button"
            data-copy={code}
            class="cursor-pointer rounded-sm border border-line-700 bg-transparent px-[9px] py-[5px] font-mono text-[11px] font-semibold text-sage-400 hover:text-mist-100"
          >
            copy
          </button>
        )}
      </div>
    )
  }
  {/* GitHub's dark rules with the syntax colors of the design tokens (src/lib/code-theme.mjs). */}
  <Code code={code} lang={lang} theme={CODE_THEME} transformers={[styleToClass]} />
</div>
