---
import Kicker from './Kicker.astro';

interface Props {
  kicker: string;
  title: string;
}
const { kicker, title } = Astro.props;
---

<section data-tone="dark" class="bg-night-950 text-mist-100">
  <div class="mx-auto max-w-[1240px] px-5 pb-12 pt-14 md:px-10">
    <Kicker>{kicker}</Kicker>
    <h1 class="mt-3 font-display text-[clamp(34px,4.2vw,52px)] font-bold leading-[1.05] tracking-[-0.025em]">
      {title}
    </h1>
    <div class="content-links mt-4 max-w-[760px] text-[17px] leading-[1.7] text-sage-400">
      <slot />
    </div>
  </div>
</section>
