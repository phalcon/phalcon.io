---
import Section from '../Section.astro';
import Kicker from '../Kicker.astro';
import DiamondBullet from '../DiamondBullet.astro';

const runtimes = [
  'nginx + php-fpm',
  'FrankenPHP · worker mode',
  'RoadRunner · PSR-7',
  'Swoole · coroutines',
];
const ecoRows = [
  { name: 'Zephir', desc: 'The language the C-extension era was built in', tag: 'core' },
  { name: 'Volt', desc: 'Fast, precompiled templating engine', tag: 'core' },
  { name: 'PHQL', desc: 'Database-agnostic, ORM-level query language', tag: 'core' },
  { name: 'DevTools successor', desc: 'Scaffolding & code generation', tag: 'wip' },
  { name: 'Phalcon MCP server', desc: 'AI-assistant access to docs & scaffolding', tag: 'new' },
];
---

<Section id="ecosystem" tone="light">
  <div class="grid grid-cols-1 items-start gap-14 lg:grid-cols-2">
    <div>
      <Kicker>No extension · no compile step</Kicker>
      <h2 class="mt-[14px] font-display text-[clamp(28px,3.2vw,38px)] font-bold leading-[1.08] tracking-[-0.02em]">
        Runs where PHP runs.
      </h2>
      <p class="mt-4 max-w-[460px] text-base leading-[1.65] text-(--tone-muted)">
        Because v6 is pure PHP, it runs on whatever you already deploy — and gets faster on worker-mode runtimes without
        any code change.
      </p>
      <div class="mt-[26px] flex flex-wrap gap-[10px]">
        {
          runtimes.map((rt) => (
            <span class="rounded-xs border border-lightline-200 bg-white px-[13px] py-[9px] font-mono text-[13px] font-semibold text-ink-900">
              {rt}
            </span>
          ))
        }
      </div>
    </div>
    <div>
      <p class="mb-[14px] font-mono text-xs font-semibold uppercase tracking-[0.16em] text-(--tone-muted)">
        The ecosystem
      </p>
      <div class="flex flex-col overflow-hidden rounded-lg border border-lightline-200 bg-white">
        {
          ecoRows.map((row, i) => (
            <div class:list={['flex items-center gap-[14px] px-[18px] py-[15px]', i > 0 && 'border-t border-paper-100']}>
              <DiamondBullet color="#2f8f5b" />
              <div class="flex-1">
                <div class="font-display text-[15px] font-semibold leading-[1.2] text-ink-900">{row.name}</div>
                <div class="mt-[3px] text-[13px] text-ink-600">{row.desc}</div>
              </div>
              <span
                class:list={[
                  'rounded-xs border px-[7px] py-1 font-mono text-[10px] font-semibold uppercase tracking-[0.06em]',
                  row.tag === 'new' ? 'border-lightline-400 text-teal-600' : 'border-lightline-200 text-ink-600',
                ]}
              >
                {row.tag}
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</Section>
