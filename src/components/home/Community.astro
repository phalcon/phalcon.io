---
import ContributorWall from '../ContributorWall.astro';
import Kicker from '../Kicker.astro';
import Section from '../Section.astro';
import contributors from '../../data/contributors.json';
import { FLAVORS, JOIN_LINKS, SINCE } from '../../data/site.mjs';

const stats = [
  { value: FLAVORS.v5.stars, label: 'GitHub stars', note: 'On cphalcon, the C extension.' },
  {
    value: String(contributors.length),
    label: 'Top contributors',
    note: 'Shown below. Many more people help with code, docs and tests.',
  },
  { value: String(SINCE), label: 'Shipping since', note: 'Run as a non-profit and funded by sponsors.' },
];
const label = 'mb-[14px] mt-[38px] font-mono text-xs font-semibold uppercase tracking-[0.16em] text-(--tone-muted)';
---

<Section id="community" tone="light-alt">
  <Kicker>Non-profit · community-built</Kicker>
  <h2 class="mt-[14px] max-w-[20ch] font-display text-[clamp(28px,3.2vw,38px)] font-bold leading-[1.06] tracking-[-0.02em]">
    Built by a community, funded by sponsors.
  </h2>

  <div class="mt-[34px] grid grid-cols-1 gap-[14px] sm:grid-cols-3">
    {
      stats.map((stat) => (
        <div class="rounded-md border border-lightline-200 bg-white px-6 py-[22px]">
          <div class="font-display text-[34px] font-bold leading-none text-ink-900">{stat.value}</div>
          <div class="mt-[9px] font-mono text-[11px] font-medium uppercase tracking-[0.12em] text-ink-600">{stat.label}</div>
          <p class="mt-[10px] text-[13.5px] leading-[1.5] text-ink-600">{stat.note}</p>
        </div>
      ))
    }
  </div>

  <p class={label}>Join the community</p>
  <div class="flex flex-wrap gap-2">
    {
      JOIN_LINKS.map((link) => (
        <a
          href={link.href}
          class="rounded-xs border border-lightline-300 bg-white px-[13px] py-[8px] font-mono text-xs font-semibold text-ink-900 hover:border-teal-600"
          >{link.label}</a
        >
      ))
    }
  </div>

  <p class={label}>Phalcon contributors</p>
  <ContributorWall />

  <div class="mt-9 flex flex-wrap gap-3">
    <a href="/contribute" class="rounded-sm bg-ink-900 px-[22px] py-[13px] text-[15px] font-semibold text-paper-100 hover:opacity-90"
      >Contribute</a
    >
    <a
      href="/sponsors"
      class="rounded-sm border border-lightline-300 px-[22px] py-[13px] text-[15px] font-semibold text-ink-900 hover:border-teal-600"
      >Fund the project</a
    >
  </div>
</Section>
