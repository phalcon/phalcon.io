---
import Card from '../Card.astro';
import DiamondBullet from '../DiamondBullet.astro';
import Kicker from '../Kicker.astro';
import Section from '../Section.astro';
import SectionHeading from '../SectionHeading.astro';
import { FLAVORS } from '../../data/site.mjs';

const flowNodes = [
  ['PHP STARTS', 'server boots'],
  ['EXTENSION', 'loaded once'],
  ['REQUEST', 'incoming HTTP'],
  ['COMPILED CLASSES', 'ready in memory'],
  ['RESPONSE', 'emit output'],
];

// From the "low overhead" text of the old site.
const points = [
  'Zephir/C extensions load together with PHP, one time, when the web server daemon starts.',
  'The classes and functions of the extension are ready for every application.',
  'The code is compiled for the platform and processor, so it is not interpreted.',
  'Thanks to this low-level architecture and its optimizations, Phalcon has the lowest overhead for MVC-based applications.',
];
---

<Section id="why" tone="dark">
  <Kicker>Why it is fast</Kicker>
  <SectionHeading class="max-w-[760px]">Low overhead, by design.</SectionHeading>
  <p class="mt-5 max-w-[720px] text-[17px] leading-[1.7] text-(--tone-muted)">
    Phalcon uses less memory and CPU than traditional frameworks, because the framework is already compiled and loaded
    before the first request arrives.
  </p>

  <div class="mt-11 overflow-x-auto rounded-lg border border-line-700 bg-surface-950 px-[26px] py-[30px]">
    <div class="mb-[22px] flex min-w-[720px] items-center justify-between">
      <span class="font-mono text-[11px] font-semibold uppercase tracking-[0.18em] text-faint-500"
        >How a request reaches your code</span
      >
      <span class="font-mono text-[11px] font-semibold text-faint-600">extension: load once ↻ every request</span>
    </div>
    <div class="flex min-w-[720px] items-stretch">
      {
        flowNodes.map((node, i) => (
          <>
            <div
              class="flex-1 border border-line-700 bg-surface-900 px-2 py-4 text-center"
              style="clip-path: polygon(0 0, 100% 0, 100% 78%, 92% 100%, 0 100%);"
            >
              <div class="font-mono text-[13px] font-bold tracking-[0.06em] text-accent-400">{node[0]}</div>
              <div class="mt-[7px] font-mono text-[11px] font-medium leading-[1.3] text-faint-600">{node[1]}</div>
            </div>
            {i < flowNodes.length - 1 && (
              <div class="flex items-center px-[6px]" aria-hidden="true">
                <svg width="30" height="12" viewBox="0 0 30 12">
                  <line x1="0" y1="6" x2="22" y2="6" stroke="#3f5950" stroke-width="1.5" stroke-dasharray="3 3" />
                  <path d="M22 2 L29 6 L22 10" fill="none" stroke="#74ccb2" stroke-width="1.5" />
                </svg>
              </div>
            )}
          </>
        ))
      }
    </div>
  </div>

  <ul class="mt-[34px] grid grid-cols-1 gap-x-8 gap-y-4 md:grid-cols-2">
    {
      points.map((point) => (
        <li class="flex items-start gap-3 text-[15px] leading-[1.65] text-mist-300">
          <DiamondBullet color="#74ccb2" class="mt-[7px]" />
          {point}
        </li>
      ))
    }
  </ul>

  <div class="mt-[34px]">
    <Card variant="accent" label="The tradeoff, stated plainly" labelColor="#8fc19a" barColor="#8fc19a">
      Phalcon v6 gives up the raw speed of the compiled extension. In return, there is nothing to install or compile: it
      runs on any host with PHP {FLAVORS.v6.php}, and every method is readable in your vendor directory.
    </Card>
  </div>
</Section>
