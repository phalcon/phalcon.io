---
// The full roster on /sponsors: logo groups as logos, the other groups as names.
import data from '../sponsors.json';
import { logoSections, nameSections } from '../lib/sponsors.mjs';

const logos = logoSections(data.sponsors);
const names = nameSections(data.sponsors);
---

{
  logos.map((section) => (
    <div class="mt-10 first:mt-0">
      <p class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-(--tone-muted)">{section.title}</p>
      <ul class="mt-5 flex flex-wrap items-center gap-x-10 gap-y-6">
        {section.entries.map((sponsor) => (
          <li>
            <a href={sponsor.url} rel="noopener sponsored" target="_blank" data-sponsor>
              <img src={sponsor.logo} alt={sponsor.name} loading="lazy" class="h-9 w-auto max-w-[180px] object-contain" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))
}
{
  names.map((section) => (
    <div class="mt-10">
      <p class="font-mono text-xs font-semibold uppercase tracking-[0.16em] text-(--tone-muted)">{section.title}</p>
      <ul class="mt-4 flex flex-wrap gap-2">
        {section.entries.map((sponsor) => (
          <li>
            <a
              href={sponsor.url}
              rel="noopener sponsored"
              target="_blank"
              data-sponsor
              class="inline-block rounded-xs border border-(--tone-border-strong) bg-(--tone-surface) px-[13px] py-[8px] font-mono text-xs font-semibold text-(--tone-text) hover:border-(--tone-accent)"
              >{sponsor.name}</a
            >
          </li>
        ))}
      </ul>
    </div>
  ))
}
