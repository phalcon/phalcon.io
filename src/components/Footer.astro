---
import { FOOTER_COLUMNS } from '../data/site';
const year = new Date().getFullYear();
---

<footer data-tone="dark" class="border-t border-line-900 bg-night-950 text-mist-100">
  <div class="mx-auto grid max-w-[1240px] grid-cols-1 gap-8 px-5 pb-10 pt-14 sm:grid-cols-2 md:px-10 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
    <div>
      <div class="flex items-center gap-[10px]">
        <img src="/images/falcon.svg" alt="" class="block h-[30px] w-[30px]" />
        <span class="font-display text-lg font-bold">Phalcon</span>
      </div>
      <p class="mt-4 max-w-[260px] text-sm leading-relaxed text-faint-500">
        A full-stack PHP framework engineered for low per-request overhead. Now pure PHP.
      </p>
      <p class="mt-[14px] font-mono text-[11px] font-medium leading-relaxed text-faint-700">
        cphalcon (v5) · BSD-3 &nbsp;·&nbsp; phalcon (v6) · MIT
      </p>
    </div>
    {FOOTER_COLUMNS.map((col) => (
      <div>
        <p class="mb-[14px] font-mono text-[11px] font-semibold uppercase tracking-[0.14em] text-faint-500">{col.title}</p>
        <div class="flex flex-col gap-[10px] text-sm">
          {col.links.map((link) => (
            <a href={link.href} class="text-accent-400 hover:text-accent-500">{link.label}</a>
          ))}
        </div>
      </div>
    ))}
  </div>
  <div class="border-t border-line-900">
    <div class="mx-auto flex max-w-[1240px] flex-wrap items-center justify-between gap-[10px] px-5 py-[18px] md:px-10">
      <span class="font-mono text-xs font-medium text-faint-700">© {year} Phalcon Framework · non-profit, sponsor-funded</span>
      <span class="font-mono text-xs font-medium text-faint-700">v6 · beta · pure PHP</span>
    </div>
  </div>
</footer>
