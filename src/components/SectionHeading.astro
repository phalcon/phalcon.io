---
interface Props {
  id?: string;
  size?: 'lg' | 'md';
  class?: string;
}
const { id, size = 'lg', class: className = '' } = Astro.props;
const sizeClass =
  size === 'lg'
    ? 'text-[clamp(30px,3.6vw,44px)]'
    : 'text-[clamp(28px,3.2vw,38px)]';
---

<h2
  id={id}
  class:list={[
    'mt-[14px] font-display font-bold leading-[1.06] tracking-[-0.02em] text-(--tone-heading)',
    sizeClass,
    className,
  ]}
>
  <slot />
</h2>
